DGROUP:0042E1DC	aUsageUharcComm	db 'Usage: UHARC command [-switches..] '
DGROUP:0042E1DC	db 'archive[.uha] [files..@listfile..!e'
DGROUP:0042E1DC	db 'xclude..]',0Ah
DGROUP:0042E1DC	db '---< Commands >--------------------'
DGROUP:0042E1DC	db '-----------------------------------'
DGROUP:0042E1DC	db '---------',0Ah
DGROUP:0042E1DC	db ' a  create archive and Add files   '
DGROUP:0042E1DC	db '      e  Extract files to current d'
DGROUP:0042E1DC	db 'irectory',0Ah
DGROUP:0042E1DC	db ' m  create archive and Move files  '
DGROUP:0042E1DC	db '      x  eXtract files with full pa'
DGROUP:0042E1DC	db 'thname',0Ah
DGROUP:0042E1DC	db ' l  List files in archive          '
DGROUP:0042E1DC	db '      t  Test files in archive',0Ah
DGROUP:0042E1DC	db '---< Switches >--------------------'
DGROUP:0042E1DC	db '-----------------------------------'
DGROUP:0042E1DC	db '---------',0Ah
DGROUP:0042E1DC	db ' d<0..2>     Set display mode (0 = '
DGROUP:0042E1DC	db 'quiet, 1 = default, 2 = verbose)',0Ah
DGROUP:0042E1DC	db ' m<0..3,x,z> Set cmp.mode (0 = STOR'
DGROUP:0042E1DC	db 'E, 1..3 = ALZ:fast..best, x = PPM, '
DGROUP:0042E1DC	db 'z = LZP)',0Ah
DGROUP:0042E1DC	db ' md<n>       Set dictionary size in'
DGROUP:0042E1DC	db ' KByte (must be power of 2 : 1 .. 3'
DGROUP:0042E1DC	db '2768)',0Ah
DGROUP:0042E1DC	db ' mm[-,+]     Disable/enable built-i'
DGROUP:0042E1DC	db 'n multimedia detection/compression',0Ah
DGROUP:0042E1DC	db ' o[-,+,p]    Overwrite existing fil'
DGROUP:0042E1DC	db 'es (- = never, + = always, p = prom'
DGROUP:0042E1DC	db 'pt)',0Ah
DGROUP:0042E1DC	db ' p<-,r,f>    Store (- = no, r = rel'
DGROUP:0042E1DC	db 'ative, f = full) pathnames',0Ah
DGROUP:0042E1DC	db ' pw[passwd]  Set password          '
DGROUP:0042E1DC	db '      |  ac[-,+]    Clear file arch'
DGROUP:0042E1DC	db 'ive attr',0Ah
DGROUP:0042E1DC	db ' r[-,+]      Recurse subdirectories'
DGROUP:0042E1DC	db '      |  ae<attr>   Set attr exclus'
DGROUP:0042E1DC	db 'ion mask',0Ah
DGROUP:0042E1DC	db ' t<dir>      Set extract target dir'
DGROUP:0042E1DC	db '      |  b<n>       Set max filebuf'
DGROUP:0042E1DC	db 'fer size',0Ah
DGROUP:0042E1DC	db ' v[-,size]   *Volumes not supported'
DGROUP:0042E1DC	db ' yet  |  bpb[-,+]   bpb instead of '
DGROUP:0042E1DC	db '%% ratio',0Ah
DGROUP:0042E1DC	db ' vm[-,+]     Set virtual memory usa'
DGROUP:0042E1DC	db 'ge    |  ed[-,+]    Store empty dir'
DGROUP:0042E1DC	db 'ectories',0Ah
DGROUP:0042E1DC	db ' y[-,+]      Assume yes on all quer'
DGROUP:0042E1DC	db 'ies   |  lg<file>   Log output to <'
DGROUP:0042E1DC	db 'file>',0Ah
DGROUP:0042E1DC	db '-----------------------------------'
DGROUP:0042E1DC	db '-----------------------------------'
DGROUP:0042E1DC	db '---------',0Ah,0
